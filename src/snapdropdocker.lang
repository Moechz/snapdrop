# ===========================================================================
# Multilingual file for the TOS 7 Docker application "snapdropdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Snapdrop"
auth         = "Snapdrop"
version      = "@@VERSION@@"
descript     = "Snapdrop is a local file transfer tool in the browser: devices on the same network see each other and can send files or text with a click, like AirDrop. This package runs the LinuxServer Docker Hub image as a non-root container with nginx serving the client and a small node signalling server behind it."
release_note = "1. First release."
important    = "Open http://<NAS-IP>:8117/ on two devices in the same LAN and send a file. All transfers are peer-to-peer in the browser; the server only does signalling. The container runs as uid 1000. Needs DockerEngine; configure a registry mirror if Docker Hub is unreachable. Plain HTTP on the LAN (WebRTC still works; some browsers require HTTPS for advanced features)."

[zh-cn]
name         = "Snapdrop"
auth         = "Snapdrop"
version      = "@@VERSION@@"
descript     = "习惯打卡与连续天数统计，界面简洁。"
release_note = "1. First release."
important    = "首次使用请打开网页完成初始化。数据保存在 DockerAppData/beaverhabitsdocker，重启和升级不会丢失。容器以 uid 1000 运行，挂载目录需对该用户可读。需要 DockerEngine；Docker Hub 不可达时先配置镜像加速。卸载并删除数据前请备份。局域网内为 HTTP。"

[zh-hk]
name         = "Snapdrop"
auth         = "Snapdrop"
version      = "@@VERSION@@"
descript     = "习惯打卡与连续天数统计，界面简洁。"
release_note = "1. First release."
important    = "首次使用請開啟網頁完成初始化。資料保存在 DockerAppData/beaverhabitsdocker，重新啟動和升級不會遺失。容器以 uid 1000 運行，掛載目錄需對該使用者可讀。需要 DockerEngine；Docker Hub 不可達時先設定鏡像加速。解除安裝並刪除資料前請備份。區域網路內為 HTTP。"

